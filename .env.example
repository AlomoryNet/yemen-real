# Yemen Real Estate Portal - Environment Configuration Template
# Copy this file to .env or pass these environment variables at build/runtime.

# Supabase Project URL (e.g. https://your-project.supabase.co)
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon Public Key (Safe for client-side use with RLS enabled)
# DO NOT place service_role key here!
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Default Platform Settings
DEFAULT_CURRENCY=YER
SUPPORT_PHONE=+967770000000
SUPPORT_WHATSAPP=+967770000000
